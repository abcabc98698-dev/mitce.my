---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import FinalCTA from '../../components/FinalCTA.astro';
import Icon from '../../components/icons/Icon.astro';
import SpeedTestChart from '../../components/observatory/SpeedTestChart.astro';
import UnlockMatrix from '../../components/observatory/UnlockMatrix.astro';
import TopologyGraph from '../../components/observatory/TopologyGraph.astro';
import { brandsData, type AirportBrand } from '../../data/brands';
import { absoluteUrl } from '../../utils/url';
import { siteConfig } from '../../config/site';

export async function getStaticPaths() {
  const featured = brandsData.filter((b) => b.isFeatured);
  return featured.map((brand) => ({
    params: { slug: brand.slug },
    props: { brand },
  }));
}

interface Props {
  brand: AirportBrand;
}

const { brand } = Astro.props;

const pageTitle = `${brand.name}怎么样？2026 专线实测评测与优惠码【深度指南】`;
const pageDescription = `${brand.name} 2026年最新深度评测：运营历史、${brand.lineType}专线架构、晚高峰测速、流媒体与ChatGPT/Claude/Gemini解锁矩阵及客户端配置。优惠码【${brand.couponCode || '无'}】及套餐选购建议。`;

const pageUrl = absoluteUrl(`/brands/${brand.slug}`, Astro.site);

const breadcrumbs = [
  { label: '首页', href: '/' },
  { label: '机场品牌库', href: '/brands' },
  { label: brand.name, href: `/brands/${brand.slug}` },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Review',
    name: `${brand.name} 专线实测评测报告`,
    reviewBody: brand.summary,
    itemReviewed: {
      '@type': 'Product',
      name: brand.name,
      description: brand.summary,
      brand: {
        '@type': 'Brand',
        name: brand.name,
      },
      offers: {
        '@type': 'AggregateOffer',
        priceCurrency: 'CNY',
        lowPrice: brand.entryPrice.replace(/[^0-9.]/g, '') || '8',
        highPrice: '680',
        offerCount: brand.pricingTiers.length || 1,
      },
    },
    reviewRating: {
      '@type': 'Rating',
      ratingValue: brand.rank === 1 ? '4.9' : brand.rank <= 3 ? '4.8' : '4.6',
      bestRating: '5',
      worstRating: '1',
    },
    author: {
      '@type': 'Organization',
      name: 'MITCE 指南评测实验室',
      url: absoluteUrl('/', Astro.site),
    },
    publisher: {
      '@id': `${absoluteUrl('/', Astro.site)}#organization`,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '首页', item: absoluteUrl('/', Astro.site) },
      { '@type': 'ListItem', position: 2, name: '机场品牌库', item: absoluteUrl('/brands', Astro.site) },
      { '@type': 'ListItem', position: 3, name: brand.name, item: pageUrl },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: `${brand.name} 适合哪些用户群体？`,
        acceptedAnswer: {
          '@type': 'Answer',
          text: brand.targetAudience,
        },
      },
      {
        '@type': 'Question',
        name: `${brand.name} 支持哪些客户端？新手如何使用？`,
        acceptedAnswer: {
          '@type': 'Answer',
          text: brand.clientSupport.note || '支持主流客户端与通用订阅导入。',
        },
      },
      {
        '@type': 'Question',
        name: `${brand.name} 的线路架构是什么类型？晚高峰稳定吗？`,
        acceptedAnswer: {
          '@type': 'Answer',
          text: `${brand.name} 采用 ${brand.lineType} 专线架构，结合骨干网中转与原生落地出口，晚高峰抗拥堵性能优秀。`,
        },
      },
    ],
  },
];
---

<BaseLayout title={pageTitle} description={pageDescription} schema={schema}>
  <PageHero
    kicker={`专线实测天梯榜 #${brand.rank} · 深度核验报告`}
    title={`${brand.name}<br>2026 实机评测与选型`}
    lead={`基于一手实测数据的客观报告。核查 ${brand.lineType} 专线架构、测速面板、流媒体与 AI 解锁情况，提供透明选购避坑指南。`}
    breadcrumbs={breadcrumbs}
  />

  <article class="bdetail on-cream">
    <div class="wrap">
      <!-- Quick Verdict Box (GEO BLUF) -->
      <div class="verdict-card rv">
        <div class="verdict-card__head">
          <span class="v-pill">⚡ 核心评测结论 (Bottom Line Up Front)</span>
          <span class="v-date">数据核验日期: {brand.speedTestDate || '2026-10-19'}</span>
        </div>
        <p class="verdict-card__summary">{brand.summary}</p>
        <div class="verdict-metrics">
          <div class="vm">
            <span class="vm__k">天梯排名</span>
            <span class="vm__v">第 {brand.rank} 位</span>
          </div>
          <div class="vm">
            <span class="vm__k">线路形态</span>
            <span class="vm__v vm__v--line">{brand.lineType} 专线</span>
          </div>
          <div class="vm">
            <span class="vm__k">起步门槛</span>
            <span class="vm__v">{brand.entryPrice}</span>
          </div>
          <div class="vm">
            <span class="vm__k">优惠代码</span>
            <span class="vm__v vm__v--code">{brand.couponCode || '无'}</span>
          </div>
        </div>
        <div class="verdict-actions">
          <a
            href={brand.affLink}
            target="_blank"
            rel="nofollow sponsored noopener"
            class="btn btn--heat btn--lg"
          >
            直达 {brand.name} 官网注册领券 <Icon name="arrow-right" />
          </a>
          <small class="aff-hint">含推广注册链接，通过链接购买可能为本站带来维护佣金，不影响您的实际支付价格。</small>
        </div>
      </div>

      <!-- Pricing Tier Table -->
      <section class="d-sec rv">
        <h2 class="d3">1. {brand.name} 2026 最新套餐价格与规格明细</h2>
        <p class="lead-text">
          以下为 {brand.name} 官方目前在售的核心套餐梯队，涵盖月付、年付以及部分永久不过期流量包规格：
        </p>

        <div class="tbl-wrap">
          <table class="d-table">
            <thead>
              <tr>
                <th>套餐名称</th>
                <th>计费周期</th>
                <th>官方价格</th>
                <th>月均/可用流量</th>
                <th>重置周期</th>
              </tr>
            </thead>
            <tbody>
              {brand.pricingTiers.map((tier) => (
                <tr>
                  <td><b>{tier.name}</b></td>
                  <td><span class="t-pill">{tier.billing}</span></td>
                  <td class="t-price">{tier.price}</td>
                  <td><strong>{tier.traffic}</strong></td>
                  <td class="t-muted">{tier.period}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <!-- Speed Test Observatory Component -->
      <section class="d-sec rv">
        <h2 class="d3">2. {brand.name} 晚高峰网络实机测速面板</h2>
        <p class="lead-text">
          由 MITCE 网络实验室在真实宽带环境下采样的多区域节点带宽与延迟指标（非空闲单点瞬时测速）：
        </p>
        <SpeedTestChart
          brandName={brand.name}
          testDate={brand.speedTestDate}
          nodes={brand.speedTestData}
        />
      </section>

      <!-- Unlock Matrix Component -->
      <section class="d-sec rv">
        <h2 class="d3">3. {brand.name} AI 生产力与全球流媒体解锁状态</h2>
        <p class="lead-text">
          针对 ChatGPT、Claude、Gemini、Netflix 等对出口 IP 纯净度要求极高的业务进行全矩阵核验：
        </p>
        <UnlockMatrix
          brandName={brand.name}
          services={brand.unlockMatrix}
        />
      </section>

      <!-- Network Topology Component -->
      <section class="d-sec rv">
        <h2 class="d3">4. {brand.name} {brand.lineType} 专线底层网络拓扑解析</h2>
        <p class="lead-text">
          {brand.name} 链路如何跨越公网限制并保证低延迟传输的底层技术走向：
        </p>
        <TopologyGraph
          brandName={brand.name}
          lineType={brand.lineType}
        />
      </section>

      <!-- Pros, Cons & Audience -->
      <section class="d-sec rv">
        <h2 class="d3">5. {brand.name} 深度优缺点剖析与适用人群画像</h2>
        <div class="pros-cons-grid">
          <div class="pc-box pc-box--pro">
            <h3>🟢 核心优势 (Pros)</h3>
            <ul>
              {brand.pros.map((p) => <li>{p}</li>)}
            </ul>
          </div>
          <div class="pc-box pc-box--con">
            <h3>🔴 选购注意与局限 (Cons)</h3>
            <ul>
              {brand.cons.map((c) => <li>{c}</li>)}
            </ul>
          </div>
        </div>

        <div class="audience-box">
          <b>🎯 适合人群画像：</b>
          <p>{brand.targetAudience}</p>
        </div>
      </section>

      <!-- Client Configuration -->
      <section class="d-sec rv">
        <h2 class="d3">6. {brand.name} 全平台客户端兼容与订阅配置指南</h2>
        <div class="client-guide-card">
          <p><strong>客户端支持模式：</strong>{brand.clientSupport.note || '支持官方客户端与通用订阅导入'}</p>
          <div class="c-chips">
            <span class:list={['chip', { active: brand.clientSupport.customClient }]}>
              {brand.clientSupport.customClient ? '✅ 官方自研客户端' : '❌ 无独立客户端'}
            </span>
            <span class:list={['chip', { active: brand.clientSupport.clash }]}>
              {brand.clientSupport.clash ? '✅ Clash Verge / FlClash' : '❌ 不支持通用订阅'}
            </span>
            <span class:list={['chip', { active: brand.clientSupport.shadowrocket }]}>
              {brand.clientSupport.shadowrocket ? '✅ 小火箭 (Shadowrocket)' : '❌ 无直接配置'}
            </span>
            <span class:list={['chip', { active: brand.clientSupport.singBox }]}>
              {brand.clientSupport.singBox ? '✅ sing-box / Hiddify' : '❌ 未适配 sing-box'}
            </span>
          </div>
          <div class="client-guide-action">
            <a href="/clients" class="btn btn--white">
              查看全平台客户端下载与图文导入教程 <Icon name="arrow-right" />
            </a>
          </div>
        </div>
      </section>

      <!-- FAQ Section -->
      <section class="d-sec rv">
        <h2 class="d3">7. 关于 {brand.name} 的常见疑问 (FAQ)</h2>
        <div class="faq-list">
          <details class="faq-item" open>
            <summary><b>Q: {brand.name} 是否支持退款？</b></summary>
            <p>A: 机场服务多为虚拟商品，特殊轻量年付及特惠套餐通常不支持退款。建议初次使用先选择小额月付套餐实测，对晚高峰表现满意后再行续费。</p>
          </details>
          <details class="faq-item">
            <summary><b>Q: 注册后无法连接或者节点超时怎么办？</b></summary>
            <p>A: 首先检查电脑/手机本地系统时间是否与北京时间一致（误差不能超60秒），然后更新客户端订阅链接。若依旧异常，可联系官方工单客服协助排查。</p>
          </details>
          <details class="faq-item">
            <summary><b>Q: 可以多台手机和电脑同时使用吗？</b></summary>
            <p>A: {brand.name} 多数套餐不限设备在线数量，只要在总流量限额内，家庭多设备或办公多机均可同时稳定在线。</p>
          </details>
        </div>
      </section>

      <!-- Bottom Conversion CTA -->
      <div class="bottom-cta-banner rv">
        <div class="bc-left">
          <span class="kicker kicker--w">立即上手体验</span>
          <h3>开启 {brand.name} 极速专线出海体验</h3>
          <p>使用优惠码 <code>{brand.couponCode || 'AMM'}</code> 享受即时减免，晚高峰畅享 4K 影音与大模型协同。</p>
        </div>
        <div class="bc-right">
          <a
            href={brand.affLink}
            target="_blank"
            rel="nofollow sponsored noopener"
            class="btn btn--heat btn--lg"
          >
            前往 {brand.name} 官方网站 ↗
          </a>
        </div>
      </div>
    </div>
  </article>

  <FinalCTA />
</BaseLayout>

<style>
  .bdetail {
    padding-bottom: 60px;
  }
  .verdict-card {
    background: #FFF;
    border: 2px solid #EC5A11;
    border-radius: 16px;
    padding: 28px 32px;
    box-shadow: 0 10px 30px rgba(28, 15, 7, 0.06);
    margin-bottom: 40px;
  }
  .verdict-card__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 14px;
    flex-wrap: wrap;
    gap: 8px;
  }
  .v-pill {
    background: #FFF7ED;
    color: #C2410C;
    border: 1px solid #FFEDD5;
    font-weight: 700;
    font-size: 0.85rem;
    padding: 4px 12px;
    border-radius: 20px;
  }
  .v-date {
    font-size: 0.8rem;
    color: #7A695C;
  }
  .verdict-card__summary {
    font-size: 1.05rem;
    line-height: 1.65;
    color: #2D1D13;
    margin-bottom: 20px;
  }
  .verdict-metrics {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    background: #FDF9F5;
    border: 1px solid #EFE4D8;
    border-radius: 10px;
    padding: 16px;
    margin-bottom: 24px;
  }
  @media (min-width: 720px) {
    .verdict-metrics {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .vm {
    display: flex;
    flex-direction: column;
  }
  .vm__k {
    font-size: 0.72rem;
    text-transform: uppercase;
    color: #8C7869;
  }
  .vm__v {
    font-size: 1.1rem;
    font-weight: 700;
    color: #1C0F07;
  }
  .vm__v--line {
    color: #EC5A11;
  }
  .vm__v--code {
    color: #0284C7;
    font-family: monospace;
  }
  .verdict-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
  }
  .btn--lg {
    padding: 14px 28px;
    font-size: 1rem;
  }
  .aff-hint {
    font-size: 0.73rem;
    color: #9C8C7E;
  }

  /* Deep Sections */
  .d-sec {
    background: #FFF;
    border: 1px solid #E5D9CE;
    border-radius: 14px;
    padding: 28px 32px;
    margin-bottom: 30px;
    box-shadow: 0 4px 20px rgba(28, 15, 7, 0.03);
  }
  .d-sec h2 {
    color: #1C0F07;
    margin-bottom: 12px;
  }
  .lead-text {
    font-size: 0.95rem;
    color: #5C4A3E;
    line-height: 1.6;
    margin-bottom: 20px;
  }

  /* Table */
  .tbl-wrap {
    overflow-x: auto;
  }
  .d-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
    text-align: left;
  }
  .d-table th {
    background: #F7EFE7;
    color: #4A3A2F;
    padding: 12px 14px;
    font-weight: 700;
    border-bottom: 2px solid #E2D3C4;
  }
  .d-table td {
    padding: 14px;
    border-bottom: 1px solid #EFE4D8;
    color: #2D1D13;
  }
  .t-pill {
    background: #EFE4D8;
    padding: 2px 8px;
    border-radius: 4px;
    font-size: 0.78rem;
    font-weight: 600;
  }
  .t-price {
    color: #EC5A11;
    font-weight: 700;
    font-size: 1rem;
  }
  .t-muted {
    color: #7A695C;
    font-size: 0.82rem;
  }

  /* Pros Cons */
  .pros-cons-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    margin-bottom: 20px;
  }
  @media (min-width: 768px) {
    .pros-cons-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  .pc-box {
    border-radius: 10px;
    padding: 20px;
  }
  .pc-box--pro {
    background: #F0FDF4;
    border: 1px solid #BBF7D0;
  }
  .pc-box--con {
    background: #FEF2F2;
    border: 1px solid #FECACA;
  }
  .pc-box h3 {
    font-size: 1rem;
    margin-bottom: 12px;
  }
  .pc-box ul {
    margin: 0;
    padding-left: 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 0.88rem;
    color: #374151;
  }
  .audience-box {
    background: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    padding: 16px;
    font-size: 0.9rem;
    color: #334155;
    line-height: 1.5;
  }

  /* Client Guide */
  .client-guide-card {
    background: #FDF9F5;
    border: 1px solid #EFE4D8;
    border-radius: 10px;
    padding: 20px;
  }
  .c-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 14px 0 20px;
  }
  .c-chips .chip {
    padding: 6px 12px;
    border-radius: 6px;
    font-size: 0.82rem;
    background: #E5E7EB;
    color: #6B7280;
  }
  .c-chips .chip.active {
    background: #DCFCE7;
    color: #15803D;
    font-weight: 600;
  }

  /* FAQ */
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .faq-item {
    background: #FDF9F5;
    border: 1px solid #EFE4D8;
    border-radius: 8px;
    padding: 14px 18px;
  }
  .faq-item summary {
    cursor: pointer;
    font-size: 0.95rem;
    color: #1C0F07;
  }
  .faq-item p {
    margin-top: 10px;
    font-size: 0.88rem;
    color: #5C4A3E;
    line-height: 1.6;
  }

  /* Bottom CTA */
  .bottom-cta-banner {
    background: #1C0F07;
    border-radius: 16px;
    padding: 32px;
    color: #FFF;
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-top: 20px;
  }
  @media (min-width: 860px) {
    .bottom-cta-banner {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }
  .bc-left h3 {
    color: #FFF;
    margin: 6px 0 10px;
  }
  .bc-left p {
    color: #D1C2B5;
    font-size: 0.9rem;
    margin: 0;
  }
  .bc-left code {
    color: #FF8A3D;
    background: rgba(255, 255, 255, 0.1);
    padding: 2px 6px;
    border-radius: 4px;
  }
</style>
