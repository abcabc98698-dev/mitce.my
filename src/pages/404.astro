---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Button from '../components/Button.astro';
import { siteConfig } from '../config/site';
import { url } from '../utils/url';
---

<BaseLayout title="404 - 页面未找到" description="您访问的页面不存在或已被移除。请返回首页或查阅 2026 机场推荐与客户端配置教程。" noindex>
  <PageHero
    class="nf"
    center
    kicker="Error 404 · 页面未找到"
    title="该路由不存在或内容已更新"
    lead="您访问的页面可能已调整链接结构或已被迁移。您可以返回首页继续浏览，或通过下方核心入口直达相关专题与评测数据。"
  >
    <span slot="before" class="nf__code rv" aria-hidden="true">404</span>
    <div class="btns rv" style="--d:190ms">
      <Button href="/" variant="white">返回网站首页</Button>
      <Button href={siteConfig.cta.href} variant="ow">{siteConfig.cta.label}</Button>
    </div>
    <nav class="nf__links rv" style="--d:250ms" aria-label="核心栏目导航">
      <a href={url('/jichang/')}>机场推荐</a>
      <a href={url('/brands/')}>品牌评测库</a>
      <a href={url('/tutorial/')}>客户端教程</a>
      <a href={url('/clash/')}>Clash 专题</a>
      <a href={url('/free/')}>免费资源</a>
      <a href={url('/blog/')}>深度测评</a>
    </nav>
  </PageHero>
</BaseLayout>
