---
/**
 * MITCE AI geometric monogram.
 * `light`  — white mark for header.
 * `footer` — cream frame with orange mark for dark footer.
 */
interface Props {
  variant?: 'light' | 'footer';
}

const { variant = 'light' } = Astro.props;
const c =
  variant === 'footer'
    ? { frame: '#FFF6EC', frameOpacity: '.5', mark: '#FF8A3D', dot: '#1C0F07', dotStroke: '#FF8A3D' }
    : { frame: '#fff', frameOpacity: '.65', mark: '#fff', dot: '#EC5A11', dotStroke: '#fff' };
---

<svg viewBox="0 0 36 36" fill="none" aria-hidden="true" focusable="false">
  <rect x=".9" y=".9" width="34.2" height="34.2" rx="10" stroke={c.frame} stroke-width="1.4" opacity={c.frameOpacity}></rect>
  <path d="M 9.5 25.5 V 10.5 H 13.5 L 18 18.2 L 22.5 10.5 H 26.5 V 25.5 H 22.8 V 16.2 L 18.8 22.8 H 17.2 L 13.2 16.2 V 25.5 Z" fill={c.mark}></path>
  <circle cx="18" cy="11.2" r="2.2" fill={c.dot} stroke={c.dotStroke} stroke-width="1.2"></circle>
</svg>
