---
import Icon from './icons/Icon.astro';
import { type BlogPost, readingTime } from '../utils/blog';
import { url } from '../utils/url';

interface Props {
  post: BlogPost;
  delay?: number;
  /** Heading level for the card title. */
  level?: 'h2' | 'h3';
  /** Show the date in the meta row (blog index). */
  showDate?: boolean;
}

const { post, delay = 0, level = 'h3', showDate = false } = Astro.props;
const Heading = level;
const href = url(`/blog/${post.id}`);
const minutes = readingTime(post);
---

<article class="post rv" style={delay ? `--d:${delay}ms` : undefined} data-category={post.data.category}>
  <div class="post__i">
    <img src={url(post.data.image)} alt={post.data.imageAlt} width="1200" height="750" loading="lazy" decoding="async" />
  </div>
  <div class="post__m">
    <em>{post.data.category}</em>
    {showDate && <time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' })}</time>}
    <span>{minutes} 分钟阅读</span>
  </div>
  <Heading class="d4"><a href={href}>{post.data.title}</a></Heading>
  <p>{post.data.description}</p>
  <span class="arrow arrow--heat" aria-hidden="true"><span>阅读测评</span><Icon name="arrow-right" /></span>
</article>
