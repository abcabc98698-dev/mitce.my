---
import { siteConfig } from '../config/site';
import { absoluteUrl, url } from '../utils/url';

export interface SEOProps {
  /** Page title without the site name. Omit on the homepage. */
  title?: string;
  description?: string;
  /** Image path in /public (e.g. "/images/ai-agency-hero.webp") or an absolute URL. */
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  /** ISO dates for articles. */
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  tags?: string[];
  noindex?: boolean;
  /** JSON-LD objects to print for this page. */
  schema?: Record<string, unknown>[];
}

type Props = SEOProps;

const {
  title,
  description = siteConfig.description,
  image = siteConfig.seo.ogImage,
  imageAlt = siteConfig.seo.ogImageAlt,
  type = 'website',
  publishedTime,
  modifiedTime,
  author,
  tags = [],
  noindex = false,
  schema = [],
} = Astro.props;

const fallbackSite = new URL('https://mitce.my');
const siteOrigin = Astro.site ?? fallbackSite;

const fullTitle = title ? `${title}${siteConfig.seo.titleSeparator}${siteConfig.name}` : siteConfig.seo.defaultTitle;
const rawPath = Astro.url.pathname;
const pathname = rawPath.endsWith('/') || rawPath.includes('.') ? rawPath : `${rawPath}/`;
const canonical = new URL(pathname, siteOrigin).toString();
const imageUrl = /^https?:\/\//.test(image) ? image : absoluteUrl(image, siteOrigin);
const homeUrl = absoluteUrl('/', siteOrigin);

const siteSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': `${homeUrl}#organization`,
    name: siteConfig.name,
    legalName: siteConfig.name,
    url: homeUrl,
    logo: absoluteUrl('/favicon.svg', siteOrigin),
    email: siteConfig.email,
    telephone: siteConfig.phone,
    address: {
      '@type': 'PostalAddress',
      streetAddress: siteConfig.location.lines[0],
      addressLocality: siteConfig.location.lines[1],
    },
    sameAs: siteConfig.social.filter((s) => /^https?:\/\//.test(s.href)).map((s) => s.href),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${homeUrl}#website`,
    name: siteConfig.name,
    url: homeUrl,
    description: siteConfig.description,
    inLanguage: siteConfig.lang,
    publisher: { '@id': `${homeUrl}#organization` },
  },
];
const jsonLd = [...siteSchema, ...schema];
---

<title>{fullTitle}</title>
{siteConfig.verification?.google && <meta name="google-site-verification" content={siteConfig.verification.google} />}
{siteConfig.verification?.bing && <meta name="msvalidate.01" content={siteConfig.verification.bing} />}
{siteConfig.verification?.shenma && <meta name="shenma-site-verification" content={siteConfig.verification.shenma} />}
{siteConfig.verification?.baidu && <meta name="baidu-site-verification" content={siteConfig.verification.baidu} />}
<meta name="description" content={description} />
<meta name="referrer" content="strict-origin-when-cross-origin" />
{!noindex && <link rel="canonical" href={canonical} />}
{!noindex && <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />}
{noindex && <meta name="robots" content="noindex, follow" />}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={siteConfig.name} />
<meta property="og:locale" content={siteConfig.locale} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
{type === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
{type === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
{type === 'article' && author && <meta property="article:author" content={author} />}
{type === 'article' && tags.map((tag) => <meta property="article:tag" content={tag} />)}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={imageAlt} />
{siteConfig.seo.twitterHandle && <meta name="twitter:site" content={siteConfig.seo.twitterHandle} />}

<meta name="theme-color" content={siteConfig.seo.themeColor} />
<link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
<link rel="alternate" type="application/rss+xml" title={`${siteConfig.name} — Insights`} href={url('/rss.xml')} />
<link rel="sitemap" href={url('/sitemap-index.xml')} />

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
