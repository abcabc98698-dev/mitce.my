---
import Brand from './Brand.astro';
import { mainNav } from '../data/navigation';
import { siteConfig } from '../config/site';
import { url } from '../utils/url';
import { ariaCurrent } from '../utils/nav';

const path = Astro.url.pathname;
const isExternalCta = /^https?:\/\//.test(siteConfig.cta.href);
---

<header class="hdr" id="hdr">
  <div class="wrap">
    <div class="hdr__in">
      <Brand />
      <nav class="mainnav" aria-label="Main">
        <ul>
          {mainNav.map((item) => (
            <li><a href={url(item.href)} aria-current={ariaCurrent(item, path)}>{item.label}</a></li>
          ))}
        </ul>
      </nav>
      <a
        href={url(siteConfig.cta.href)}
        target={isExternalCta ? '_blank' : undefined}
        rel={isExternalCta ? 'nofollow sponsored noopener' : undefined}
        class="btn btn--ow"
      >
        {siteConfig.cta.shortLabel}
      </a>
      <button class="burger" id="burger" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mob">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>
